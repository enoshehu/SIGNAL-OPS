# Copy to .env only if your chosen runner loads dotenv files.
# SIGNAL//OPS itself reads environment variables directly and never commits secrets.
SIGNALOPS_ENV=development
SIGNALOPS_CONFIG=config/base.toml
SIGNALOPS_DATA_DIR=data

# Deutsche Bahn Timetables API credentials (obtain from the DB API marketplace).
DB_API_CLIENT_ID=
DB_API_KEY=
